<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Food Result | NutriVision AI</title>
    <link rel="stylesheet" href="/css/style.css">

    <style>
        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            background: #eff8f4;
            font-family: Arial, sans-serif;
            color: #243e35;
        }

        .result-container {
            max-width: 1400px;
            width: 94%;
            margin: 30px auto;
        }

        .result-header {
            background: linear-gradient(135deg, #087f68, #42b89a);
            padding: 35px;
            border-radius: 22px;
            color: white;
            margin-bottom: 25px;
        }

        .result-header h1 {
            font-size: 36px;
            margin: 12px 0;
        }

        .result-header p {
            color: white;
            line-height: 1.6;
        }

        .result-layout {
            display: grid;
            grid-template-columns: 0.85fr 1.15fr;
            gap: 25px;
        }

        .result-panel {
            background: white;
            padding: 30px;
            border-radius: 22px;
            box-shadow: 0 8px 25px rgba(0, 80, 60, 0.07);
            min-width: 0;
        }

        .result-panel h2 {
            color: #087f68;
            margin-bottom: 20px;
        }

        .food-panel {
            text-align: center;
        }

        .food-image {
            width: 100%;
            max-width: 400px;
            height: 320px;
            object-fit: contain;
            background: #f3f8f5;
            border-radius: 20px;
            margin: 15px 0;
        }

        .food-name {
            font-size: 30px;
            color: #087f68;
            margin: 15px 0;
        }

        .ai-badge {
            display: inline-block;
            background: #e1f5eb;
            color: #087f68;
            padding: 12px 20px;
            border-radius: 30px;
            font-weight: bold;
        }

        .serving-box {
            background: #e7f5ed;
            color: #087f68;
            padding: 18px;
            border-radius: 12px;
            margin: 20px 0;
            font-weight: bold;
        }

        .nutrition-grid {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 15px;
        }

        .nutrition-card {
            background: #f0f8f4;
            border: 1px solid #d3e9df;
            border-radius: 18px;
            padding: 25px 10px;
            text-align: center;
            transition: 0.3s;
        }

        .nutrition-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 8px 20px rgba(0, 100, 70, 0.1);
        }

        .nutrition-icon {
            font-size: 35px;
            margin-bottom: 12px;
        }

        .nutrition-card h3 {
            color: #087f68;
            font-size: 27px;
            margin: 12px 0;
        }

        .nutrition-card p {
            color: #647d72;
            font-size: 15px;
        }

        .nutrition-note {
            background: #fff8e7;
            color: #806322;
            padding: 15px;
            border-radius: 12px;
            margin-top: 20px;
            font-size: 14px;
            line-height: 1.6;
        }

        .section-spacing {
            margin-top: 25px;
        }

        .prediction-grid {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 20px;
        }

        .prediction-card {
            background: #edf7f3;
            padding: 20px;
            border-radius: 15px;
            border: 1px solid #d3e9df;
        }

        .prediction-card h3 {
            color: #087f68;
            margin-bottom: 10px;
        }

        .prediction-rank {
            display: inline-block;
            padding: 8px 14px;
            border-radius: 20px;
            background: #087f68;
            color: white;
            font-size: 13px;
        }

        .correction-controls {
            display: flex;
            gap: 15px;
            margin-top: 20px;
        }

        .food-select {
            flex: 1;
            min-width: 0;
            padding: 15px;
            border: 1px solid #b9d9cc;
            border-radius: 10px;
            background: #f5fbf8;
            color: #243e35;
            font-size: 16px;
        }

        .quantity-input {
            width: 100%;
            padding: 12px;
            margin-top: 12px;
            border: 1px solid #b9d9cc;
            border-radius: 10px;
            font-size: 18px;
        }

        .result-button {
            display: inline-block;
            padding: 15px 25px;
            background: #087f68;
            color: white;
            border: none;
            border-radius: 10px;
            text-decoration: none;
            font-size: 16px;
            font-weight: bold;
            cursor: pointer;
            text-align: center;
            transition: 0.3s;
        }

        .result-button:hover {
            background: #056451;
            color: white;
        }

        .result-button:disabled {
            opacity: 0.6;
            cursor: not-allowed;
        }

        .result-actions {
            display: flex;
            justify-content: center;
            flex-wrap: wrap;
            gap: 15px;
            margin: 30px 0;
        }

        .small-note {
            color: #72877e;
            font-size: 14px;
            line-height: 1.6;
            margin-top: 15px;
            overflow-wrap: anywhere;
        }

        .health-layout {
            display: flex;
            align-items: center;
            justify-content: center;
            flex-wrap: wrap;
            gap: 35px;
            padding: 25px;
        }

        .health-circle {
            width: 170px;
            height: 170px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            background: #e1eee7;
        }

        .health-inner {
            width: 145px;
            height: 145px;
            border-radius: 50%;
            background: white;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
        }

        .health-inner h1 {
            font-size: 45px;
            margin: 0;
        }

        .benefit-box {
            background: #eff8f4;
            padding: 20px;
            border-radius: 15px;
            margin-top: 20px;
        }

        .suggestion-box {
            background: #fff8e7;
            padding: 20px;
            border-radius: 15px;
            margin-top: 20px;
        }

        .meal-grid {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 15px;
            margin: 20px 0;
        }

        .meal-option {
            padding: 20px 10px;
            background: #f0f8f4;
            border: 1px solid #d3e9df;
            border-radius: 15px;
            text-align: center;
            cursor: pointer;
        }

        .meal-option:has(input:checked) {
            background: #d8f2e7;
            border: 2px solid #087f68;
        }

        .meal-icon {
            font-size: 30px;
            display: block;
            margin-bottom: 10px;
        }

        .save-preview {
            background: #e7f5ed;
            padding: 20px;
            border-radius: 15px;
            margin: 20px 0;
            line-height: 1.8;
        }

        #correctionMessage,
        #saveFoodMessage {
            margin-top: 15px;
            font-weight: bold;
        }

        @media (max-width: 900px) {
            .result-layout {
                grid-template-columns: 1fr;
            }

            .prediction-grid {
                grid-template-columns: 1fr;
            }
        }

        @media (max-width: 600px) {
            .result-container {
                width: 94%;
                margin: 15px auto;
            }

            .result-header {
                padding: 25px;
            }

            .result-header h1 {
                font-size: 27px;
            }

            .result-panel {
                padding: 20px;
            }

            .nutrition-grid,
            .meal-grid {
                grid-template-columns: repeat(2, 1fr);
            }

            .food-image {
                height: 260px;
            }

            .correction-controls,
            .result-actions {
                flex-direction: column;
            }
        }
    </style>
</head>

<body>

<main
    class="result-container"
    id="resultContainer"
    data-nutrition="<%= JSON.stringify(nutrition || null) %>"
    data-health="<%= JSON.stringify(healthScore || null) %>"
>

    <header class="result-header">

        <p>🌿 NUTRIVISION AI | AI POWERED FOOD INTELLIGENCE</p>

        <h1>Food Analysis Result 🍽️</h1>

        <p>
            Discover your food and understand its nutritional value
            with AI-powered food recognition.
        </p>

    </header>

    <div class="result-layout">

        <section class="result-panel food-panel">

            <h2>AI Food Recognition</h2>

            <img
                src="/uploads/<%= imageName %>"
                alt="Uploaded Food"
                class="food-image"
            >

            <h2 class="food-name" id="displayFoodName">
                <%= foodName %>
            </h2>

            <p id="recognitionStatus">
                AI Predicted Food
            </p>

            <div id="confidenceSection">

                <span class="ai-badge">
                    ✨ Google Gemini AI
                </span>

                <p class="small-note">
                    Best suggested match.
                    Please confirm the food name before saving.
                </p>

            </div>

            <p class="small-note">
                Original AI Prediction: <%= foodName %>
            </p>

            <p class="small-note">
                File Name: <%= originalName %>
            </p>

        </section>

        <section class="result-panel">

            <h2>🥗 Nutrition Information</h2>

            <p>
                Estimated nutritional breakdown of your food.
            </p>

            <div class="serving-box">

                🍽️ Serving Size:

                <span id="servingValue">
                    <%= nutrition ? nutrition.serving : "Unavailable" %>
                </span>

            </div>

            <div class="serving-box">

                <h3>🍽️ Select Serving Quantity</h3>

                <label for="servingQuantity">
                    Number of Servings
                </label>

                <input
                    type="number"
                    id="servingQuantity"
                    class="quantity-input"
                    value="1"
                    min="0.25"
                    max="20"
                    step="0.25"
                >

                <p id="quantityMessage"></p>

            </div>

            <div class="nutrition-grid">

                <div class="nutrition-card">

                    <div class="nutrition-icon">🔥</div>

                    <p>Calories</p>

                    <h3 id="caloriesValue">
                        <%= nutrition ? nutrition.calories : "--" %>
                    </h3>

                    <p>kcal</p>

                </div>

                <div class="nutrition-card">

                    <div class="nutrition-icon">💪</div>

                    <p>Protein</p>

                    <h3 id="proteinValue">
                        <%= nutrition ? nutrition.protein : "--" %>
                    </h3>

                    <p>grams</p>

                </div>

                <div class="nutrition-card">

                    <div class="nutrition-icon">🍞</div>

                    <p>Carbohydrates</p>

                    <h3 id="carbsValue">
                        <%= nutrition ? nutrition.carbs : "--" %>
                    </h3>

                    <p>grams</p>

                </div>

                <div class="nutrition-card">

                    <div class="nutrition-icon">🥑</div>

                    <p>Fat</p>

                    <h3 id="fatValue">
                        <%= nutrition ? nutrition.fat : "--" %>
                    </h3>

                    <p>grams</p>

                </div>

                <div class="nutrition-card">

                    <div class="nutrition-icon">🥦</div>

                    <p>Fiber</p>

                    <h3 id="fiberValue">
                        <%= nutrition ? nutrition.fiber : "--" %>
                    </h3>

                    <p>grams</p>

                </div>

                <div class="nutrition-card">

                    <div class="nutrition-icon">🍬</div>

                    <p>Sugar</p>

                    <h3 id="sugarValue">
                        <%= nutrition ? nutrition.sugar : "--" %>
                    </h3>

                    <p>grams</p>

                </div>

            </div>

            <div class="nutrition-note">

                ⚠️ Nutrition values are approximate estimates.
                Actual values depend on ingredients, preparation
                method and serving size.

            </div>

        </section>

    </div>

    <section class="result-panel section-spacing">

        <h2>💚 Food Health Analysis</h2>

        <div id="healthScoreContent"></div>

        <p class="small-note">
            This score is based on an illustrative nutrition formula.
            It is not a medical assessment.
        </p>

    </section>

    <section class="result-panel section-spacing">

        <h2>🤖 AI Food Predictions</h2>

        <p>
            Possible food matches suggested by Gemini AI.
        </p>

        <div class="prediction-grid">

            <% topPredictions.forEach((prediction, index) => { %>

                <div class="prediction-card">

                    <span class="prediction-rank">

                        <%= index === 0 ? "Best Match" : "Match " + (index + 1) %>

                    </span>

                    <h3>
                        <%= prediction.foodName %>
                    </h3>

                    <button
                        type="button"
                        class="result-button prediction-button"
                        data-food="<%= prediction.foodName %>"
                    >
                        Select Food
                    </button>

                </div>

            <% }); %>

        </div>

        <p class="small-note">

            Predictions are ranked suggestions, not measured
            confidence percentages.

        </p>

    </section>

    <section class="result-panel section-spacing">

        <h2>✏️ Correct Food Recognition</h2>

        <p>
            If the AI prediction is incorrect, select the correct
            food from our supported food database.
        </p>

        <div class="correction-controls">

            <select id="correctFood" class="food-select">

                <% foodLabels.forEach(food => { %>

                    <option
                        value="<%= food %>"
                        <%= food === foodName ? "selected" : "" %>
                    >

                        <%= food %>

                    </option>

                <% }); %>

            </select>

            <button
                type="button"
                id="updateButton"
                class="result-button"
                onclick="updateFood()"
            >
                Update Food
            </button>

        </div>

        <p id="correctionMessage" role="status"></p>

    </section>

    <section class="result-panel section-spacing">

        <h2>📅 Save to Food Diary</h2>

        <p>
            Select your meal type and save this food to your
            daily nutrition dashboard.
        </p>

        <div class="meal-grid">

            <label class="meal-option">

                <span class="meal-icon">🌅</span>

                <input
                    type="radio"
                    name="mealType"
                    value="Breakfast"
                >

                Breakfast

            </label>

            <label class="meal-option">

                <span class="meal-icon">🍛</span>

                <input
                    type="radio"
                    name="mealType"
                    value="Lunch"
                >

                Lunch

            </label>

            <label class="meal-option">

                <span class="meal-icon">🥪</span>

                <input
                    type="radio"
                    name="mealType"
                    value="Snacks"
                    checked
                >

                Snacks

            </label>

            <label class="meal-option">

                <span class="meal-icon">🌙</span>

                <input
                    type="radio"
                    name="mealType"
                    value="Dinner"
                >

                Dinner

            </label>

        </div>

        <div class="save-preview">

            <strong>Food Diary Preview</strong>

            <p>
                Food:
                <span id="previewFood"></span>
            </p>

            <p>
                Meal:
                <span id="previewMeal"></span>
            </p>

            <p>
                Quantity:
                <span id="previewQuantity"></span>
            </p>

            <p>
                Calories:
                <span id="previewCalories"></span>
            </p>

        </div>

        <button
            type="button"
            id="saveFoodButton"
            class="result-button"
            style="width:100%;"
            onclick="saveFood()"
        >

            💾 Save Food Analysis

        </button>

        <p id="saveFoodMessage" role="status"></p>

    </section>

    <div class="result-actions">

        <a href="/food-analysis" class="result-button">

            📷 Analyze Another Food

        </a>

        <a href="/dashboard" class="result-button">

            🏠 Back to Dashboard

        </a>

    </div>

</main>

<script>

    const container = document.getElementById("resultContainer");

    let baseNutrition = JSON.parse(
        container.dataset.nutrition
    );

    let currentHealthScore = JSON.parse(
        container.dataset.health
    );

    let currentFoodName = document
        .getElementById("displayFoodName")
        .textContent.trim();

    let isUpdating = false;
    let isSaving = false;
    let isSaved = false;

    const quantityInput = document.getElementById(
        "servingQuantity"
    );

    const foodSelect = document.getElementById(
        "correctFood"
    );

    const updateButton = document.getElementById(
        "updateButton"
    );

    const saveButton = document.getElementById(
        "saveFoodButton"
    );

    function getMealType() {

        return document.querySelector(
            'input[name="mealType"]:checked'
        ).value;

    }

    function validQuantity() {

        const quantity = Number(quantityInput.value);

        return Number.isFinite(quantity) &&
            quantity >= 0.25 &&
            quantity <= 20;

    }

    function calculate(value, quantity) {

        return Number(
            (Number(value) * quantity).toFixed(2)
        );

    }

    function updateControls() {

        const busy = isUpdating || isSaving || isSaved;

        updateButton.disabled = busy;

        quantityInput.disabled = busy;

        foodSelect.disabled = busy;

        saveButton.disabled =
            busy ||
            !validQuantity() ||
            !baseNutrition ||
            foodSelect.value !== currentFoodName;

        document.querySelectorAll(
            'input[name="mealType"], .prediction-button'
        ).forEach(element => {

            element.disabled = busy;

        });

    }

    function updatePreview() {

        document.getElementById(
            "previewFood"
        ).textContent = currentFoodName;

        document.getElementById(
            "previewMeal"
        ).textContent = getMealType();

        document.getElementById(
            "previewQuantity"
        ).textContent = validQuantity()
            ? quantityInput.value + " serving(s)"
            : "Invalid quantity";

        document.getElementById(
            "previewCalories"
        ).textContent = baseNutrition && validQuantity()
            ? calculate(
                baseNutrition.calories,
                Number(quantityInput.value)
            ) + " kcal"
            : "--";

    }

    function calculateNutrition() {

        const quantity = Number(quantityInput.value);

        const message = document.getElementById(
            "quantityMessage"
        );

        const nutrients = [
            "calories",
            "protein",
            "carbs",
            "fat",
            "fiber",
            "sugar"
        ];

        if (!baseNutrition || !validQuantity()) {

            message.textContent = !baseNutrition
                ? "Nutrition information unavailable."
                : "Enter a quantity between 0.25 and 20.";

            nutrients.forEach(key => {

                document.getElementById(
                    key + "Value"
                ).textContent = "--";

            });

            updatePreview();
            updateControls();

            return;

        }

        nutrients.forEach(key => {

            document.getElementById(
                key + "Value"
            ).textContent = calculate(
                baseNutrition[key],
                quantity
            );

        });

        message.textContent =
            quantity + " × " + baseNutrition.serving;

        updatePreview();

        updateControls();

    }

    function updateHealthScore(health, foodName) {

        const healthContainer = document.getElementById(
            "healthScoreContent"
        );

        if (!health) {

            healthContainer.textContent =
                "Health analysis is currently unavailable.";

            return;

        }

        healthContainer.innerHTML = `

            <div class="health-layout">

                <div class="health-circle" id="healthCircle">

                    <div class="health-inner">

                        <h1 id="healthScoreValue"></h1>

                        <p>Out of 100</p>

                    </div>

                </div>

                <div>

                    <h2 id="healthFoodName"></h2>

                    <h3 id="healthRating"></h3>

                    <p>Estimated Nutrition Score</p>

                </div>

            </div>

            <div class="benefit-box">

                <h3>💪 Nutrition Benefits</h3>

                <ul id="healthBenefits"></ul>

            </div>

            <div class="suggestion-box">

                <h3>💡 Nutrition Suggestions</h3>

                <ul id="healthSuggestions"></ul>

            </div>

        `;

        const score = Math.max(
            0,
            Math.min(100, Number(health.score) || 0)
        );

        const color = /^#[0-9a-f]{3,8}$/i.test(
            health.color || ""
        ) ? health.color : "#087f68";

        document.getElementById(
            "healthScoreValue"
        ).textContent = score;

        document.getElementById(
            "healthScoreValue"
        ).style.color = color;

        document.getElementById(
            "healthFoodName"
        ).textContent = foodName;

        document.getElementById(
            "healthRating"
        ).textContent = health.rating || "Unavailable";

        document.getElementById(
            "healthRating"
        ).style.color = color;

        document.getElementById(
            "healthCircle"
        ).style.background =
            `conic-gradient(${color} ${score}%, #e1eee7 0)`;

        function updateList(id, items, emptyMessage) {

            const list = document.getElementById(id);

            list.innerHTML = "";

            const values =
                Array.isArray(items) && items.length
                    ? items
                    : [emptyMessage];

            values.forEach(item => {

                const li = document.createElement("li");

                li.textContent = item;

                li.style.margin = "10px 0";

                list.appendChild(li);

            });

        }

        updateList(
            "healthBenefits",
            health.benefits,
            "No specific benefits flagged."
        );

        updateList(
            "healthSuggestions",
            health.suggestions,
            "No additional suggestions."
        );

    }

    async function updateFood() {

        if (isUpdating || isSaving || isSaved) return;

        const selectedFood = foodSelect.value;

        const message = document.getElementById(
            "correctionMessage"
        );

        isUpdating = true;

        updateControls();

        message.textContent =
            "Updating nutrition information...";

        try {

            const response = await fetch(

                "/api/nutrition?food=" +
                encodeURIComponent(selectedFood)

            );

            if (!response.ok) {

                throw new Error(
                    "Nutrition data unavailable"
                );

            }

            const data = await response.json();

            baseNutrition = data.nutrition;

            currentHealthScore = data.healthScore;

            currentFoodName = data.foodName;

            document.getElementById(
                "displayFoodName"
            ).textContent = currentFoodName;

            document.getElementById(
                "servingValue"
            ).textContent = baseNutrition.serving;

            document.getElementById(
                "recognitionStatus"
            ).textContent = "Manually Selected Food";

            document.getElementById(
                "confidenceSection"
            ).style.display = "none";

            quantityInput.value = 1;

            updateHealthScore(
                currentHealthScore,
                currentFoodName
            );

            calculateNutrition();

            message.textContent =
                "✓ Food and nutrition updated successfully!";

            message.style.color = "#087f68";

        } catch (error) {

            message.textContent =
                "Unable to update food. Please try again.";

            message.style.color = "#c0392b";

        } finally {

            isUpdating = false;

            updateControls();

        }

    }

    async function saveFood() {

        if (isSaving || isUpdating || isSaved) return;

        const message = document.getElementById(
            "saveFoodMessage"
        );

        if (!baseNutrition || !validQuantity()) {

            message.textContent =
                "Please enter a valid serving quantity.";

            return;

        }

        if (foodSelect.value !== currentFoodName) {

            message.textContent =
                "Please click Update Food before saving.";

            return;

        }

        const quantity = Number(quantityInput.value);

        const mealType = getMealType();

        isSaving = true;

        updateControls();

        saveButton.textContent = "Saving...";

        try {

            const response = await fetch(

                "/api/save-food",

                {

                    method: "POST",

                    headers: {
                        "Content-Type": "application/json"
                    },

                    body: JSON.stringify({

                        foodName: currentFoodName,

                        quantity,

                        mealType

                    })

                }

            );

            const data = await response.json();

            if (!response.ok) {

                throw new Error(
                    data.message || "Unable to save food."
                );

            }

            isSaved = true;

            message.textContent =
                "✓ Food saved successfully! Check your dashboard.";

            message.style.color = "#087f68";

            saveButton.textContent =
                "✓ Food Saved Successfully";

        } catch (error) {

            message.textContent = error.message;

            message.style.color = "#c0392b";

            saveButton.textContent =
                "💾 Save Food Analysis";

        } finally {

            isSaving = false;

            updateControls();

        }

    }

    quantityInput.addEventListener(
        "input",
        calculateNutrition
    );

    foodSelect.addEventListener(
        "change",
        updateControls
    );

    document.querySelectorAll(
        'input[name="mealType"]'
    ).forEach(input => {

        input.addEventListener(
            "change",
            updatePreview
        );

    });

    document.querySelectorAll(
        ".prediction-button"
    ).forEach(button => {

        button.addEventListener("click", () => {

            if (isUpdating || isSaving || isSaved) return;

            foodSelect.value = button.dataset.food;

            updateFood();

        });

    });

    calculateNutrition();

    updateHealthScore(
        currentHealthScore,
        currentFoodName
    );

    updateControls();

</script>

</body>
</html>